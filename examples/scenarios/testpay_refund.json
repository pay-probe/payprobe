{
  "name": "TestPay · Refund",
  "description": "Authorize, then refund by RRN. The refund references the original auth's retrieval reference number — mirrors the TestPay RefundTestStrategy.",
  "tags": ["testpay", "refund", "regression"],
  "stop_on_failure": true,
  "timeout_ms": 10000,
  "test_class": "e2e",
  "steps": [
    {
      "id": "step_001",
      "target": "http",
      "action": "send_auth_request",
      "payload": { "amount": 10000, "currency": "GEL", "card_profile": "visa_credit_standard" },
      "assertions": [
        { "field": "response_code", "operator": "eq", "expected": "00" },
        { "field": "rrn", "operator": "present" }
      ]
    },
    {
      "id": "step_002",
      "target": "http",
      "action": "send_refund",
      "payload": { "rrn": "${step_001.response.rrn}", "amount": 10000 },
      "assertions": [
        { "field": "response_code", "operator": "eq", "expected": "00" }
      ]
    }
  ]
}
