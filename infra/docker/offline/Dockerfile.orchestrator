# Offline build of the orchestrator (worker engine in-process) with Oracle
# thick-mode support for adapters that open Oracle sessions. Context = kit root.
FROM python:3.12-slim
WORKDIR /app
# Instant Client needs libaio; the kit ships the .deb when the build host has no apt mirror.
COPY debs /debs
# trixie ships libaio as libaio.so.1t64; the Instant Client dlopens libaio.so.1.
RUN if ls /debs/*.deb >/dev/null 2>&1; then dpkg -i /debs/*.deb; fi && rm -rf /debs \
 && for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu; do \
      if [ -e "$d/libaio.so.1t64" ] && [ ! -e "$d/libaio.so.1" ]; then ln -s libaio.so.1t64 "$d/libaio.so.1"; fi; done
COPY wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
    "fastapi>=0.110" "uvicorn[standard]>=0.27" "redis[hiredis]>=5.0" \
    "pydantic>=2.0" "httpx>=0.27" "pycryptodome>=3.20" "PyJWT>=2.8" \
    "cryptography>=42.0" "aiohttp>=3.9" "nats-py>=2.6" \
    "uvloop>=0.19" "asyncpg>=0.29" "python-pkcs11>=0.7" "structlog>=23.0" "pyyaml>=6.0" \
    "oracledb>=3.0" \
 && rm -rf /wheels
COPY oracle-client/ /opt/oracle/
ENV LD_LIBRARY_PATH=/opt/oracle
COPY src/packages/worker /app/packages/worker
COPY src/packages/report_service /app/packages/report_service
COPY src/packages/payprobe_common /app/packages/payprobe_common
COPY src/packages/orchestrator /app/packages/orchestrator
COPY src/examples /app/examples
ENV PYTHONPATH=/app/packages \
    PAYPROBE_EXAMPLES_DIR=/app/examples \
    PYTHONUNBUFFERED=1
EXPOSE 8100
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8100/health')"
CMD ["uvicorn", "orchestrator.api.main:app", "--host", "0.0.0.0", "--port", "8100"]
