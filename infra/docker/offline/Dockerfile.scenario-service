# Offline build of scenario-service: context = kit root.
FROM python:3.12-slim
WORKDIR /app
COPY wheels /wheels
COPY src/packages/scenario-service/pyproject.toml src/packages/scenario-service/README.md ./
COPY src/packages/scenario-service/api ./api
COPY src/packages/scenario-service/models ./models
COPY src/packages/payprobe_common ./payprobe_common
RUN pip install --no-cache-dir --no-index --find-links=/wheels ./payprobe_common \
 && pip install --no-cache-dir --no-index --find-links=/wheels . \
 && rm -rf /wheels
ENV SCENARIO_SEED_DIR=/seed \
    PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
