# Offline build of auth-service: context = kit root (see scripts/offline_build_kit.sh).
FROM python:3.12-slim
WORKDIR /app
COPY wheels /wheels
COPY src/packages/auth-service/pyproject.toml src/packages/auth-service/README.md ./
COPY src/packages/auth-service/api ./api
COPY src/packages/auth-service/models ./models
RUN pip install --no-cache-dir --no-index --find-links=/wheels . && rm -rf /wheels
# AUTH_DB comes from the compose file (a name starting with AUTH_ in an ENV
# trips Trivy's secret check, DS-0031, though it is only a path).
ENV PYTHONUNBUFFERED=1
EXPOSE 8300
HEALTHCHECK --interval=15s --timeout=3s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8300/health')"
# Unprivileged, like the online images: the data volumes must be writable by
# uid 10001 (see docs/operations/offline-minimal-deployment.md).
RUN useradd --system --uid 10001 --no-create-home payprobe
USER payprobe
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8300"]
