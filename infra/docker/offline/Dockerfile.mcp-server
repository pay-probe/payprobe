# Offline build of the MCP server (Streamable HTTP). Context = kit root.
FROM python:3.12-slim
WORKDIR /app
COPY wheels /wheels
COPY src/packages/mcp-server/pyproject.toml src/packages/mcp-server/README.md ./
COPY src/packages/mcp-server/mcp_server ./mcp_server
RUN pip install --no-cache-dir --no-index --find-links=/wheels . && rm -rf /wheels
ENV MCP_TRANSPORT=streamable-http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8200 \
    SCENARIO_API_URL=http://scenario-service:8000 \
    RUN_API_URL=http://orchestrator:8100 \
    PYTHONUNBUFFERED=1
EXPOSE 8200
HEALTHCHECK --interval=15s --timeout=3s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8200/healthz')"
CMD ["python", "-m", "mcp_server"]
