# PayProbe deployment configuration.
# Copy to `.env` (next to docker-compose.yml) and adjust. All values have
# mock-friendly defaults baked into the compose file, so an empty .env still
# brings up a working mock stack.

# ---- published host ports ----
PORTAL_PORT=8080
ORCH_PORT=8100
SCENARIO_PORT=8000

# ---- postgres ----
POSTGRES_DB=payprobe
POSTGRES_USER=payprobe
# CHANGE THIS for any non-local deployment:
POSTGRES_PASSWORD=payprobe

# ---- redis (orchestrator event backbone) ----
REDIS_URL=redis://redis:6379

# ---- portal CORS (scenario-service) ----
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# ---- scenario-service optional bearer auth (empty = open) ----
SCENARIO_API_TOKEN=

# ---- production-only (used once real services land) ----
# JWT_SECRET=change-me
# RESTPAY_BASE_URL=https://restpay-stg.internal
# RESTPAY_API_KEY=
# PKCS11_LIB_PATH=/usr/lib/libCryptoki2.so
