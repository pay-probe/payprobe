name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

jobs:
  test-worker:
    name: Worker Engine Tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v4
        with:
          python-version: "3.11"
      - name: Install dependencies
        run: |
          cd packages/worker
          pip install -e ".[dev]"
      - name: Lint
        run: cd packages/worker && ruff check . && black --check .
      - name: Test
        run: cd packages/worker && pytest tests/ -v --cov=. --cov-report=xml

  test-services:
    name: Backend Service Tests
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_DB: payprobe_test
          POSTGRES_USER: payprobe
          POSTGRES_PASSWORD: test
        ports: ["5432:5432"]
      redis:
        image: redis:7
        ports: ["6379:6379"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v4
        with:
          python-version: "3.11"
      - name: Test report-service
        run: cd packages/report_service && pip install -e ".[dev]" && pytest tests/ -v
      - name: Test orchestrator
        run: |
          # orchestrator depends on the local payprobe-worker,
          # payprobe-report-service and payprobe-common packages (not on PyPI),
          # so install them editable first to satisfy the dependencies.
          pip install -e packages/worker -e packages/report_service -e packages/payprobe_common
          cd packages/orchestrator && pip install -e ".[dev]" && pytest tests/ -v
      - name: Test scenario-service
        # scenario-service imports the shared payprobe_common (agent toolkit +
        # crypto), so install it too.
        run: |
          pip install -e packages/payprobe_common
          cd packages/scenario-service && pip install -e ".[dev]" && pytest tests/ -v
      - name: Test mcp-server
        run: cd packages/mcp-server && pip install -e ".[dev]" && pytest tests/ -v
      - name: Test payprobe-assistant
        # the assistant's tool layer is the shared payprobe_common toolkit.
        run: |
          pip install -e packages/payprobe_common
          cd packages/payprobe-assistant && pip install -e ".[dev]" && pytest tests/ -v
      - name: Guard the showcase demo (offline)
        # scripts/showcase.py has no importer of its own — this test locks its
        # generated docs + API-call shapes against the real models/services.
        run: PYTHONPATH=packages python -m pytest scripts/test_showcase.py -v

  test-portal:
    name: Angular Portal Tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install & check formatting
        # The portal has no angular-eslint setup, so `ng lint` has no target.
        # Enforce Prettier style instead (the tooling that is configured).
        run: cd packages/portal && npm ci && npm run format:check
      - name: Build
        run: cd packages/portal && npm run build --prod

  portal-e2e:
    name: Portal e2e (golden paths)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install deps + Playwright
        # Playwright is a test-only tool, deliberately NOT in package.json (so it
        # never enters the production image's `npm ci`). e2e:install adds it with
        # --no-save and downloads the browser.
        run: cd packages/portal && npm ci && npm run e2e:install
      - name: Run UI golden-path smoke (no backend needed)
        # full-flows.spec.ts stays skipped without E2E_FULL; this runs the
        # backend-free smoke specs against the dev server Playwright starts.
        run: cd packages/portal && npm run e2e
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: packages/portal/playwright-report/

  mock-integration:
    name: Mock Integration Run
    runs-on: ubuntu-latest
    needs: [test-worker, test-services]
    env:
      # Shared secret: docker compose reads it for the orchestrator's
      # AUTH_JWT_SECRET, and the run step below mints a JWT with the same value.
      # The fail-closed gate accepts that token (HS256, exp required).
      AUTH_JWT_SECRET: ci-mock-integration-shared-secret-change-me-32b
    steps:
      - uses: actions/checkout@v4
      - name: Start mock environment
        # docker-compose.mock.yml is now an empty stub; the real compose file
        # runs the platform in MOCK mode. Bring up just the orchestrator —
        # compose starts its dependencies (redis, scenario-service,
        # auth-service) via depends_on, and skips the slow Angular portal build
        # we don't need. AUTH_JWT_SECRET (job env) flows into the container.
        run: docker compose -f infra/docker/docker-compose.yml up -d --build orchestrator
      - name: Wait for the orchestrator API
        run: |
          for i in $(seq 1 60); do
            if curl -fsS http://localhost:8100/health >/dev/null 2>&1; then
              echo "orchestrator ready"; exit 0
            fi
            echo "waiting for orchestrator API... ($i/60)"; sleep 5
          done
          echo "orchestrator did not become ready; recent logs:"
          docker compose -f infra/docker/docker-compose.yml logs --tail=80
          exit 1
      - name: Run example scenarios against mock
        # Hit the orchestrator directly on :8100 (the portal/nginx prefix isn't
        # involved here). Mint a short-lived JWT with the shared secret to get
        # past the fail-closed auth gate.
        run: |
          pip install httpx pyjwt
          PP_TOKEN=$(python -c "import jwt, time, os; print(jwt.encode({'sub': 'ci', 'exp': int(time.time()) + 3600}, os.environ['AUTH_JWT_SECRET'], algorithm='HS256'))")
          python scripts/run_example_scenarios.py --env mock --suite examples/scenarios/ --base-url http://localhost:8100 --token "$PP_TOKEN"
      - name: Stop
        if: always()
        run: docker compose -f infra/docker/docker-compose.yml down -v
