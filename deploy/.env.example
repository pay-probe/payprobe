# PayProbe deployment configuration.
# Copy to `.env` (next to docker-compose.yml) and adjust. Every value has a
# working default baked into the compose file, so an empty .env still brings up
# a working stack.

# ---- image selection ----
# Which published images to run. Defaults: datikos/payprobe-*:latest
PAYPROBE_NS=datikos
PAYPROBE_TAG=latest

# ---- published host ports ----
PORTAL_PORT=8080
ORCH_PORT=8100
SCENARIO_PORT=8000
AUTH_PORT=8300
MCP_PORT=8200
ASSIST_PORT=8400
INSIGHT_PORT=8500

# ---- postgres ----
POSTGRES_DB=payprobe
POSTGRES_USER=payprobe
# CHANGE THIS for any non-local deployment:
POSTGRES_PASSWORD=payprobe

# ---- redis (orchestrator event backbone) ----
REDIS_URL=redis://redis:6379

# ---- auth (shared JWT secret across services) ----
# CHANGE THIS for any non-local deployment:
AUTH_JWT_SECRET=dev-insecure-change-me
# dev keeps the auth gate open for local work; set to prod to enforce it.
PAYPROBE_ENV=dev

# ---- portal CORS ----
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# ---- scenario-service static bearer (optional) ----
# Extra service-to-service credential for callers that don't mint JWTs
# (curl / CI scripts): Authorization: Bearer <token>. JWT auth via
# AUTH_JWT_SECRET works regardless — leave unset unless you need it.
SCENARIO_API_TOKEN=

# ---- LLM assistant (optional) ----
# Configure the LLM provider in the portal: Settings -> AI assistant
# (applies without a restart). For prod secret-manager injection you can
# instead set ASSIST_LLM_API_KEY (+ ASSIST_LLM_PROVIDER / ASSIST_LLM_MODEL)
# here — an env key WINS over the Settings page.

# ---- observability profile (Grafana admin) ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
